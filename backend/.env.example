# ─── SERVER ───────────────────────────────────────────────────────────────────
PORT=5000
NODE_ENV=development

# ─── FRONTEND ─────────────────────────────────────────────────────────────────
# Development: http://localhost:3000
# Production:  https://ebojep.org  (or your Vercel URL)
FRONTEND_URL=http://localhost:3000

# ─── DATABASE ─────────────────────────────────────────────────────────────────
# Get from: Supabase → Project Settings → Database → Connection string (URI)
# Append ?sslmode=require for production
DATABASE_URL=postgresql://<user>:<password>@<host>:<port>/<database>

# ─── SUPABASE ─────────────────────────────────────────────────────────────────
# Get from: https://supabase.com → Project Settings → API
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_ANON_KEY=<anon_key>
SUPABASE_SERVICE_ROLE_KEY=<service_role_key>

# ─── AUTH ─────────────────────────────────────────────────────────────────────
# Generate a strong secret: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=<your_jwt_secret_min_32_chars>
JWT_EXPIRES_IN=7d

# ─── PAYSTACK ─────────────────────────────────────────────────────────────────
# Get from: https://dashboard.paystack.com → Settings → API Keys
# Use test keys for development, live keys for production
PAYSTACK_SECRET_KEY=sk_test_<your_key>
PAYSTACK_PUBLIC_KEY=pk_test_<your_key>

# ─── STORAGE ──────────────────────────────────────────────────────────────────
STORAGE_BUCKET=eboje-p-media
